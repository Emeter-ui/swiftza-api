# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=3000

# Comma-separated allowed origins. Empty = allow all (development only).
CORS_ORIGINS=https://your-frontend-domain.com

# --- MongoDB ---
# Atlas connection string. A replica set is required — the wallet layer uses
# multi-document transactions, which a standalone mongod cannot run.
MONGODB_URI=
MONGODB_DB=samzee

# --- Firebase (Auth only) ---
# Firestore is no longer used. These credentials are for Firebase Auth.
# Point them at the NEW Firebase project, not the old one.
API_KEY=
APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=

# --- Sessions ---
# Signs the login JWT. Generate with: openssl rand -base64 48
# Changing it signs every user out.
JWT_SECRET=
JWT_TTL=7d

# --- Paystack ---
# ROTATE THESE. The previous live key was committed to git history.
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co

# --- VTU providers ---
# Which adapter to use. Overridden by the SETTINGS/providers document in MongoDB if set there.
ACTIVE_PROVIDER=smeapi

PROVIDER_SMEAPI_TOKEN=
PROVIDER_SMEAPI_BASE_URL=https://smeapi.com.ng

PROVIDER_CHEAPDATAHUB_API_KEY=
PROVIDER_CHEAPDATAHUB_BASE_URL=https://www.cheapdatahub.ng/api/v1/resellers

# Upstream request timeout in milliseconds.
UPSTREAM_TIMEOUT_MS=30000
